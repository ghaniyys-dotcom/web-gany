APP_NAME="Gany Labs"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gany-kos.duckdns.org

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gany_labs
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Admin: gunakan hash (disarankan) ATAU password sementara untuk dev
# Generate hash: php artisan admin:set-password "password-kamu"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Email notifikasi saat ada pesan contact (default: email di site settings)
CONTACT_NOTIFY_EMAIL=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ghaniyys@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ghaniyys@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Tampilkan link Admin di footer (false di production)
SHOW_ADMIN_LINK=false

SITE_OG_IMAGE=/storage/images/og-cover.svg

CACHE_STORE=database
QUEUE_CONNECTION=database

# Analytics tracking salt
ANALYTICS_SALT=gany_labs_salt_123
